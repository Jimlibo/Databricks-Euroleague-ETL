{
  "datasets": [
    {
      "name": "ee0a0ecb",
      "displayName": "Player Statistics",
      "queryLines": [
        "WITH overall_averages AS (\n",
        "  SELECT\n",
        "    AVG(`points`) AS avg_points_all,\n",
        "    AVG(`offensive_rebounds` + `defensive_rebounds`) AS avg_rebounds_all,\n",
        "    AVG(`assists`) AS avg_assists_all,\n",
        "    AVG(`steals`) AS avg_steals_all\n",
        "  FROM\n",
        "    `workspace`.`euroleague`.`silver_box_score`\n",
        "  WHERE\n",
        "    `phase` = 'REGULARSEASON'\n",
        ")\n",
        "SELECT\n",
        "  `player_id`,\n",
        "  `player`,\n",
        "  `season_code`,\n",
        "  `points_average`,\n",
        "  `two_points_percentage`,\n",
        "  `three_points_percentage`,\n",
        "  `free_throw_percentage`,\n",
        "  `average_offensive_rebounds`,\n",
        "  `average_defensive_rebounds`,\n",
        "  `average_total_rebounds`,\n",
        "  `average_assists`,\n",
        "  `average_steals`,\n",
        "  oa.avg_points_all,\n",
        "  oa.avg_rebounds_all,\n",
        "  oa.avg_assists_all,\n",
        "  oa.avg_steals_all\n",
        "FROM\n",
        "  `workspace`.`euroleague`.`gold_player_stats` CROSS JOIN overall_averages oa"
      ],
      "catalog": "workspace",
      "schema": "euroleague"
    },
    {
      "name": "rebounds_breakdown",
      "displayName": "Rebounds Breakdown",
      "queryLines": [
        "SELECT\n",
        "  `player_id`,\n",
        "  `player`,\n",
        "  `season_code`,\n",
        "  'Offensive' AS rebound_type,\n",
        "  `average_offensive_rebounds` AS average_rebounds\n",
        "FROM\n",
        "  `workspace`.`euroleague`.`gold_player_stats`\n",
        "UNION ALL\n",
        "SELECT\n",
        "  `player_id`,\n",
        "  `player`,\n",
        "  `season_code`,\n",
        "  'Defensive' AS rebound_type,\n",
        "  `average_defensive_rebounds` AS average_rebounds\n",
        "FROM\n",
        "  `workspace`.`euroleague`.`gold_player_stats`"
      ],
      "catalog": "workspace",
      "schema": "euroleague"
    },
    {
      "name": "shooting_percentages",
      "displayName": "Shooting Percentages",
      "queryLines": [
        "WITH shot_data AS (\n",
        "  SELECT\n",
        "    `player_id`,\n",
        "    `player`,\n",
        "    `season_code`,\n",
        "    1 AS sort_order,\n",
        "    'Free Throw' AS shot_type,\n",
        "    `free_throw_percentage` AS percentage\n",
        "  FROM\n",
        "    `workspace`.`euroleague`.`gold_player_stats`\n",
        "  UNION ALL\n",
        "  SELECT\n",
        "    `player_id`,\n",
        "    `player`,\n",
        "    `season_code`,\n",
        "    2 AS sort_order,\n",
        "    'Two-Point' AS shot_type,\n",
        "    `two_points_percentage` AS percentage\n",
        "  FROM\n",
        "    `workspace`.`euroleague`.`gold_player_stats`\n",
        "  UNION ALL\n",
        "  SELECT\n",
        "    `player_id`,\n",
        "    `player`,\n",
        "    `season_code`,\n",
        "    3 AS sort_order,\n",
        "    'Three-Point' AS shot_type,\n",
        "    `three_points_percentage` AS percentage\n",
        "  FROM\n",
        "    `workspace`.`euroleague`.`gold_player_stats`\n",
        ")\n",
        "SELECT\n",
        "  `player_id`,\n",
        "  `player`,\n",
        "  `season_code`,\n",
        "  `sort_order`,\n",
        "  `shot_type`,\n",
        "  `percentage`,\n",
        "  CASE\n",
        "    WHEN `percentage` < 0.35 THEN 'Low'\n",
        "    WHEN\n",
        "      `percentage` >= 0.35\n",
        "      AND `percentage` <= 0.75\n",
        "    THEN\n",
        "      'Medium'\n",
        "    ELSE 'High'\n",
        "  END AS performance_level\n",
        "FROM\n",
        "  shot_data"
      ],
      "catalog": "workspace",
      "schema": "euroleague"
    },
    {
      "name": "10b6079e",
      "displayName": "Last Game Stats",
      "queryLines": [
        "SELECT \r\n",
        "    *\r\n",
        "FROM \r\n",
        "    `euroleague`.`gold_last_game_stats`"
      ]
    }
  ],
