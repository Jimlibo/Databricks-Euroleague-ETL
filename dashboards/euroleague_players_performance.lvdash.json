{
  "datasets": [
    {
      "name": "similarity_top5_last",
      "displayName": "Top 5 Lowest Similarity",
      "queryLines": [
        "SELECT\n",
        "  `player_id`,\n",
        "  CONCAT(`player`, ' (', `last_game_date`, ')') AS player_display,\n",
        "  `player`,\n",
        "  `season_code`,\n",
        "  `season_avg_similarity`,\n",
        "  `last_game_date`\n",
        "FROM\n",
        "  `gold_last_game_stats`\n",
        "WHERE\n",
        "  `season_avg_similarity` IS NOT NULL\n",
        "  AND CAST(`last_game_date` AS DATE) >= DATE_SUB(CURRENT_DATE(), 7)\n",
        "  AND CAST(`last_game_date` AS DATE) <= CURRENT_DATE()\n",
        "ORDER BY\n",
        "  `season_avg_similarity` ASC\n",
        "LIMIT 5"
      ],
      "catalog": "workspace",
      "schema": "euroleague"
    },
    {
      "name": "worst_diff_top5",
      "displayName": "Worst 5 by Total Diff",
      "queryLines": [
        "SELECT\n",
        "  `player_id`,\n",
        "  CONCAT(`player`, ' (', `last_game_date`, ')') AS player_display,\n",
        "  `player`,\n",
        "  `season_code`,\n",
        "  (\n",
        "    COALESCE(`diff_points`, 0)\n",
        "      + COALESCE(`diff_total_rebounds`, 0)\n",
        "      + COALESCE(`diff_total_assists`, 0)\n",
        "      + COALESCE(`diff_total_steals`, 0)\n",
        "  ) AS total_diff,\n",
        "  `last_game_date`\n",
        "FROM\n",
        "  `gold_last_game_stats`\n",
        "WHERE\n",
        "  CAST(`last_game_date` AS DATE) >= DATE_SUB(CURRENT_DATE(), 7)\n",
        "  AND CAST(`last_game_date` AS DATE) <= CURRENT_DATE()\n",
        "ORDER BY\n",
        "  total_diff ASC\n",
        "LIMIT 5"
      ],
      "catalog": "workspace",
      "schema": "euroleague"
    },
    {
      "name": "best_diff_top5",
      "displayName": "Best 5 by Total Diff",
      "queryLines": [
        "SELECT\n",
        "  `player_id`,\n",
        "  CONCAT(`player`, ' (', `last_game_date`, ')') AS player_display,\n",
        "  `player`,\n",
        "  `season_code`,\n",
        "  (\n",
        "    COALESCE(`diff_points`, 0)\n",
        "      + COALESCE(`diff_total_rebounds`, 0)\n",
        "      + COALESCE(`diff_total_assists`, 0)\n",
        "      + COALESCE(`diff_total_steals`, 0)\n",
        "  ) AS total_diff,\n",
        "  `last_game_date`\n",
        "FROM\n",
        "  `gold_last_game_stats`\n",
        "WHERE\n",
        "  CAST(`last_game_date` AS DATE) >= DATE_SUB(CURRENT_DATE(), 7)\n",
        "  AND CAST(`last_game_date` AS DATE) <= CURRENT_DATE()\n",
        "ORDER BY\n",
        "  total_diff DESC\n",
        "LIMIT 5"
      ],
      "catalog": "workspace",
      "schema": "euroleague"
    },
    {
      "name": "game_dates_options",
      "displayName": "Available Game Dates",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  `last_game_date`\n",
        "FROM\n",
        "  `gold_last_game_stats`\n",
        "WHERE\n",
        "  `last_game_date` IS NOT NULL\n",
        "ORDER BY\n",
        "  `last_game_date`"
      ],
      "catalog": "workspace",
      "schema": "euroleague"
    }
  ],
